[Unit]
Description=Ollama Local LLM API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pip
Group=pip
WorkingDirectory=/home/pip/robot
EnvironmentFile=/home/pip/robot/.env
Environment=OLLAMA_MODELS=/home/pip/robot/src/lib/ollama/models
Environment=OLLAMA_HOST=0.0.0.0:11434
ExecStart=/home/pip/robot/src/lib/ollama/dist/bin/ollama serve
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
