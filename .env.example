DEBUG=1
MIC_DEVICE=plughw:0,0

NAME=Pip
USER_NAME=Anton
CONTEXT_LOCATION="Vancouver Island, Canada"

# Brain
# The most conventional frequency bands are: delta [1–4 Hz], theta [4–8 Hz], alpha/mu [8–13 Hz], beta [13–30 Hz], gamma [30–80 Hz], and high gamma [80–150 Hz]
# https://pmc.ncbi.nlm.nih.gov/articles/PMC4269223/
BRAIN_FREQUENCY_DELTA=4
BRAIN_FREQUENCY_GAMMA=30
BRAIN_CONFIDENCE_THRESHOLD=0.9

CONVERSATION_HISTORY_LIMIT=8
EAVESDROP_HISTORY_LIMIT=16

# Ollama config
# Mind always runs Ollama on the RPi CPU, against the trained/personality
# model produced by src/models/ollama/train.sh and installed via
# `ollama create` on this machine - there is no base-model fallback and no
# other backend. Its Modelfile already carries the right generation
# parameters (temperature/top_k/etc.) and a baked-in SYSTEM prompt, so
# nothing else is configured here to override them.
OLLAMA_MODEL_NAME=pip
OLLAMA_THREADS=2
OLLAMA_VERSION=0.33.1

# Piper config
# ------------
PIPER_MODEL_NAME=en_US-danny-low
PIPER_MODEL_URL=https://huggingface.co/rhasspy/piper-voices/resolve/main/en/en_US/danny/low
PIPER_SAMPLE_RATE=16000

# Whisper config
# --------------
# https://hailo.ai/products/hailo-software/model-explorer/generative-ai/type/audio/
WHISPER_MODEL_HEF=Whisper-Small.hef
WHISPER_SAMPLE_RATE=16000
# Silero VAD speech probability threshold: 0.0=lenient (catches everything),
# 1.0=aggressive (filters more non-speech). Default 0.5 is Silero's own default.
WHISPER_VAD_THRESHOLD=0.5
WHISPER_WAKE_ALIASES="beep,deep,peep,pete,robot,robert,robbed"

# Web UI
#WEB_PORT=8080

# Training Config
# ---------------
# Base model to fine-tune from when training (src/models/ollama/train.sh) -
# unrelated to which model Mind loads at runtime (OLLAMA_MODEL_NAME above).
OLLAMA_BASE_MODEL=Qwen/Qwen2.5-1.5B-Instruct

# Hugging Face token (for accessing private models during training)
# Get token at https://huggingface.co/settings/tokens
TRAINING_HF_TOKEN=
