[Unit]
Description=Robot Web UI
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/home/pi/projects/robot
EnvironmentFile=/home/pi/projects/robot/.env
ExecStart=/bin/sh /home/pi/projects/robot/services/start.sh
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
