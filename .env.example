DEBUG=1
MIC_DEVICE=plughw:0,0

NAME=Pip
USER_NAME=Anton
CONTEXT_LOCATION="Vancouver Island, Canada"

# Brain
# The most conventional frequency bands are: delta [1–4 Hz], theta [4–8 Hz], alpha/mu [8–13 Hz], beta [13–30 Hz], gamma [30–80 Hz], and high gamma [80–150 Hz]
# https://pmc.ncbi.nlm.nih.gov/articles/PMC4269223/
BRAIN_FREQUENCY_DELTA=4
BRAIN_FREQUENCY_GAMMA=30
BRAIN_CONFIDENCE_THRESHOLD=0.9

EAVESDROP_HISTORY_LIMIT=32

# Which backend Mind uses for LLM inference: 'ollama' or 'hailo'
LLM_ENGINE=ollama

# Hailo Ollama config
HAILO_VERSION=5.3.0

# https://hailo.ai/products/hailo-software/model-explorer/generative-ai/type/llm/
HAILO_MODEL_HEF=Qwen2.5-1.5B-Instruct.hef

# https://hailo.ai/products/hailo-software/model-explorer/generative-ai/type/audio/
HAILO_WHISPER_MODEL_HEF=Whisper-Small.hef

HAILO_DO_SAMPLE=1
HAILO_NUM_PREDICT=64
HAILO_TEMPERATURE=0.7
HAILO_TOP_K=40
HAILO_TOP_P=0.9

# Ollama config
OLLAMA_MODEL=qwen2.5:1.5b
OLLAMA_THREADS=3
OLLAMA_VERSION=0.33.1

# Conversation model options
OLLAMA_CONTEXT_LENGTH=1024
OLLAMA_NUM_PREDICT=64
OLLAMA_REPEAT_PENALTY=1.1
OLLAMA_TEMPERATURE=0.8
OLLAMA_TOP_K=40
OLLAMA_TOP_P=0.9

OLLAMA_HISTORY_LIMIT=4
OLLAMA_SYSTEM_PROMPT="Your name is Pip. You are an autonomous mechanical robot."

# LoRA pre-trained model config
OLLAMA_BASE_MODEL=Qwen/Qwen2.5-1.5B-Instruct
OLLAMA_MODEL_NAME=pip-qwen2.5-1.5b

# Hugging Face token (for accessing private models during training)
# Get token at https://huggingface.co/settings/tokens
HF_TOKEN=

# Ollama: path to a compatible LoRA adapter.
#PERSONALIZED_MODEL=/Users/anton/Documents/STEM/RaspberryPI/Robot/robot/src/models/llm/personalized/build/pip-qwen2.5-q4_k_m.gguf

# HailoRT: leave empty; use a personality-tuned HEF in HAILO_MODEL_HEF because
# HailoRT does not load a separate LoRA adapter at runtime.
#LLM_LORA_PATH=

# Piper config
PIPER_MODEL_NAME=en_US-danny-low
PIPER_MODEL_URL=https://huggingface.co/rhasspy/piper-voices/resolve/main/en/en_US/danny/low
PIPER_SAMPLE_RATE=16000

# Whisper config
WHISPER_SAMPLE_RATE=16000
# VAD aggressiveness: 0=lenient (catches everything), 3=aggressive (filters keyboard clicks)
# Default 2 filters noise while catching normal speech
WHISPER_VAD_AGGRESSIVENESS=2
WHISPER_WAKE_ALIASES="beep,deep,peep,pete,robot,robert,robbed"

# Web UI
#WEB_PORT=8080